def _save_run_history(spark, cfg: PipelineConfig, metrics: dict):
    """
    Persiste les metriques du run dans une table Delta append-only.
    Chaque run = 1 ligne avec timestamp, config, durees, volumes.
    """
    from pyspark.sql import Row
    from datetime import datetime

    row = Row(
        run_ts=datetime.now().isoformat(),
        run_label=cfg.run_label or "default",
        input_table=cfg.input_table,
        output_table=cfg.output_table,
        tolerance=cfg.tolerance,
        objective=cfg.objective,
        max_model_size=cfg.max_model_size,
        timeout_min=cfg.timeout_min,
        timeout_max=cfg.timeout_max,
        filtre_relation=cfg.filtre_relation_actes,
        test_limit=cfg.test_limit or -1,
        nb_input=metrics.get("nb_input", 0),
        nb_cp_sat=metrics.get("nb_cp_sat", 0),
        nb_residuel=metrics.get("nb_residuel", 0),
        nb_non_traite=metrics.get("nb_non_traite", 0),
        taux_lettrage_pct=round(metrics.get("taux_pct", 0.0), 2),
        duree_total_s=round(metrics.get("duree_total_s", 0.0), 1),
        duree_chargement_s=round(metrics.get("duree_chargement_s", 0.0), 1),
        duree_solve_s=round(metrics.get("duree_solve_s", 0.0), 1),
        duree_postprocess_s=round(metrics.get("duree_postprocess_s", 0.0), 1),
        n_groupes=metrics.get("n_groupes", 0),
        n_partitions=metrics.get("n_partitions", 0),
        groupes_par_sec=round(metrics.get("groupes_par_sec", 0.0), 2),
        # P0 / evolutions
        moteur=cfg.moteur,
        politique_coherence=cfg.politique_coherence,
        passe_exacte=cfg.passe_exacte,
        nb_exact=metrics.get("nb_exact", 0),
        nb_a_revoir=metrics.get("nb_a_revoir", 0),
        nb_paquets=metrics.get("nb_paquets", 0),
        nb_paquets_non_prouves=metrics.get("nb_paquets_non_prouves", 0),
        nb_budget_depasse=metrics.get("nb_budget_depasse", 0),
    )

    df_row = spark.createDataFrame([row])
    df_row.write.format("delta").mode("append").option("mergeSchema", "true").saveAsTable(cfg.runs_history_table)
    log.info(f"  Run log -> {cfg.runs_history_table}")


# =============================================================================
# POINT D'ENTREE UNIQUE : run_pipeline
# =============================================================================

def run_pipeline(spark, cfg: PipelineConfig):
    """
    Pipeline distribue complet :
      1. Charge et nettoie (1 seul scan)
      2. Classifie (taille + timeout)
      3. Optionnel: filtre relation d'actes
      4. Solve distribue (applyInPandas, tous les groupes)
      5. Enrichit la table source avec SOURCE_LETTRAGE + ID_LETTRAGE
      6. Ecrit 1 seule table de sortie
      7. Post-processing coherence + score

    Retourne (df_detail, df_stats, df_coherence)
    """
    from pyspark.sql import functions as F

    _valider_config(cfg)

    log.info("=" * 70)
    log.info("  PIPELINE LETTRAGE DISTRIBUE (v3)")
    log.info("=" * 70)
    log.info(f"  Input      : {cfg.input_table}")
    log.info(f"  Output     : {cfg.output_table}")
    log.info(f"  Objective  : {cfg.objective}")
    log.info(f"  Tolerance  : {cfg.tolerance}")
    log.info(f"  Max model  : {cfg.max_model_size} postes")
    log.info(f"  Timeout    : {cfg.timeout_min}-{cfg.timeout_max}s (adaptatif)")
    log.info(f"  Relation   : {cfg.filtre_relation_actes}")
    log.info(f"  Hints      : {cfg.use_relation_hint} (max {cfg.max_hint_positions} pos)")
    log.info(f"  Moteur     : {cfg.moteur} | passe exacte={cfg.passe_exacte} | "
             f"non prouves->revue={cfg.router_non_prouves}")
    if cfg.moteur == "smallest_first":
        log.info(f"  Coherence  : {cfg.politique_coherence} (k_max sans relation={cfg.k_max_sans_relation}) | "
                 f"ambigus->revue={cfg.router_ambigus}")
        log.info(f"  Fenetres   : {cfg.fenetres_jours} | ecart max={cfg.ecart_max_jours} | "
                 f"departage etendue={cfg.departage_etendue}")
    if cfg.test_limit:
        log.info(f"  Test limit : {cfg.test_limit} groupes")
    log.info("=" * 70)

    t_start = time.time()
    timings = {}

    # --- 1. Chargement unique ---
    t1 = time.time()
    df, nb_total = charger_et_nettoyer(spark, cfg)
    timings["chargement"] = time.time() - t1

    # --- 1b. Filtre comptes cibles (optionnel, pour test rapide) ---
    if cfg.filter_accounts:
        if isinstance(cfg.filter_accounts, dict):
            # Format dict : filtre chaque cle independamment
            for key, values in cfg.filter_accounts.items():
                if key in df.columns and values:
                    df = df.filter(F.col(key).isin(values))
            log.info(f"  Filtre comptes (dict): {nb_total:,} -> ... (filtres: {list(cfg.filter_accounts.keys())})")
        elif isinstance(cfg.filter_accounts, (list, tuple)):
            # Format list de tuples : combinaisons exactes sur account_keys
            keys = cfg.account_keys
            conditions = []
            for grp in cfg.filter_accounts:
                if isinstance(grp, (list, tuple)) and len(grp) == len(keys):
                    cond = F.lit(True)
                    for k, v in zip(keys, grp):
                        if k in df.columns:
                            cond = cond & (F.col(k) == v)
                    conditions.append(cond)
            if conditions:
                from functools import reduce
                df = df.filter(reduce(lambda a, b: a | b, conditions))
            log.info(f"  Filtre comptes (list): {nb_total:,} -> ... ({len(cfg.filter_accounts)} groupes cibles)")
        nb_filtre = df.count()
        log.info(f"  Apres filtre: {nb_filtre:,} postes")
        nb_total = nb_filtre

    # --- 2. Classification (taille + timeout adaptatif) ---
    df = classifier_groupes(df, cfg)

    # --- 3. Filtre relation d'actes (optionnel) ---
    # Les postes exclus par ce filtre recevront NON_TRAITE
    # (car ils ne sont plus dans df_to_solve, on les re-ajoute apres)
    if cfg.filtre_relation_actes:
        df_to_solve, df_match_keys = filtrer_par_relation(spark, df, cfg)
    else:
        df_to_solve = df
        df_match_keys = None

    # --- 4. Test limit ---
    if cfg.test_limit:
        # Limiter au N premiers groupes distincts
        df_keys = df_to_solve.select(cfg.account_keys).distinct().limit(cfg.test_limit)
        df_to_solve = df_to_solve.join(df_keys, on=cfg.account_keys, how="inner")
        log.info(f"  Test limit: {cfg.test_limit} groupes")

    # --- 5. Partitionnement ---
    n_groups = df_to_solve.select(cfg.account_keys).distinct().count()
    n_partitions = min(cfg.n_partitions_hint, max(n_groups // 5, 50))
    cols_solve = cfg.account_keys + [cfg.idx_col, cfg.amount_col, "_grp_size", "_timeout_s"]
    # Ajouter _acte_norm si les relations sont utilisees dans la UDF (hints, passe exacte, coherence)
    if _relations_requises(cfg) and "_acte_norm" in df_to_solve.columns:
        cols_solve = cols_solve + ["_acte_norm"]
    # Dates en jours : fenetres, departage, passe exacte
    if (cfg.moteur == "smallest_first" or cfg.passe_exacte) and "_jour" in df_to_solve.columns:
        cols_solve = cols_solve + ["_jour"]
    # Perimetre R3 : limite dure d'etendue pour les groupes concernes
    if cfg.moteur == "smallest_first" and cfg.r3_scope:
        cols_solve = cols_solve + [c for c in (cfg.account_type_col, cfg.category_type_col)
                                   if c in df_to_solve.columns and c not in cols_solve]
    df_ready = df_to_solve.select(*cols_solve).repartition(n_partitions, *cfg.account_keys)
    log.info(f"  {n_groups:,} groupes | {n_partitions} partitions")

    # --- 6. Solve distribue ---
    bc_rel = _build_relation_broadcast(spark, cfg)
    solve_udf, output_schema = _build_solve_udf(spark, cfg, bc_rel=bc_rel)

    log.info("  Lancement applyInPandas...")
    t_solve = time.time()
    df_solved = df_ready.groupBy(*cfg.account_keys).applyInPandas(solve_udf, schema=output_schema)
    df_solved.cache()

    n_solved = df_solved.count()
    timings["solve"] = time.time() - t_solve
    comptes = {r["SOURCE_LETTRAGE"]: r["count"] for r in df_solved.groupBy("SOURCE_LETTRAGE").count().collect()}
    n_cpsat = comptes.get("CP_SAT", 0)
    n_exact = comptes.get("EXACT", 0)
    n_a_revoir = comptes.get("A_REVOIR", 0)
    n_resid = comptes.get("RESIDUEL", 0)
    n_nt = comptes.get("NON_TRAITE", 0)
    n_lettres = n_cpsat + n_exact
    # P0 : paquets et paquets sans preuve d'optimalite
    df_pq = df_solved.filter(F.col("ID_LETTRAGE").isNotNull()).select("ID_LETTRAGE", "STATUT_SOLVEUR").distinct()
    n_paquets = df_pq.count()
    n_non_prouves = df_pq.filter(~F.col("STATUT_SOLVEUR").isin("OPTIMAL", "EXACT")).count()
    n_budget = df_solved.filter(F.col("STATUT_SOLVEUR") == "BUDGET_DEPASSE").count()
    log.info(f"  Solved: {n_solved:,} postes | CP_SAT={n_cpsat:,} | EXACT={n_exact:,} | A_REVOIR={n_a_revoir:,} "
             f"| RESIDUEL={n_resid:,} | NON_TRAITE={n_nt:,}")
    log.info(f"  Paquets: {n_paquets:,} | sans preuve d'optimalite: {n_non_prouves:,} "
             f"| postes laisses par budget depasse: {n_budget:,}")

    # --- 7. Enrichir avec toutes les colonnes source ---
    cols_from_solved = ["SOURCE_LETTRAGE", "ID_LETTRAGE"]
    df_source = df.drop(*[c for c in cols_from_solved if c in df.columns])
    df_source = df_source.drop("_grp_size", "_timeout_s", "_jour")  # colonnes techniques

    df_detail = df_source.join(df_solved, on=cfg.idx_col, how="left")

    # Postes non traites par le solve (filtre relation exclu) -> NON_TRAITE
    df_detail = df_detail.withColumn("SOURCE_LETTRAGE",
        F.coalesce(F.col("SOURCE_LETTRAGE"), F.lit("NON_TRAITE"))
    )

    # Materialisation : la resolution n'est executee qu'une fois. Sans cela, chaque
    # usage du df retourne (toPandas, jointure dans le notebook appelant...) relance
    # toute la resolution apres unpersist de df_solved, avec des resultats qui
    # peuvent differer pour les groupes arretes par la limite de temps.
    # L'appelant peut liberer la memoire avec df_detail.unpersist().
    df_detail = df_detail.cache()
    df_detail.count()

    # --- 8. Ecriture ---
    if cfg.save_results:
        log.info(f"  Ecriture: {cfg.output_table}")
        df_detail.write.format("delta").mode("overwrite").option("overwriteSchema", "true").saveAsTable(cfg.output_table)
    else:
        log.info("  save_results=False (mode test)")

    # --- 9. Post-processing ---
    t_pp = time.time()
    df_stats, df_coherence = postprocess(spark, df_detail, cfg)
    timings["postprocess"] = time.time() - t_pp

    if cfg.save_results:
        df_stats.write.format("delta").mode("overwrite").option("overwriteSchema", "true").saveAsTable(cfg.output_stats_table)
        if df_coherence is not None:
            df_coherence.write.format("delta").mode("overwrite").option("overwriteSchema", "true").saveAsTable(cfg.output_coherence_table)
        log.info(f"  Stats: {cfg.output_stats_table}")
        log.info(f"  Coherence: {cfg.output_coherence_table}")

    # --- 10. Resume ---
    total_time = time.time() - t_start
    taux = n_lettres / max(nb_total, 1) * 100
    log.info("")
    log.info("=" * 70)
    log.info("  RESUME PIPELINE")
    log.info("=" * 70)
    log.info(f"  Input       : {nb_total:,} postes")
    log.info(f"  Lettres     : {n_lettres:,} ({taux:.1f}%)  dont EXACT {n_exact:,}")
    log.info(f"  A_REVOIR    : {n_a_revoir:,}")
    log.info(f"  RESIDUEL    : {n_resid:,}")
    log.info(f"  NON_TRAITE  : {n_nt:,}")
    log.info(f"  Duree totale : {total_time:.0f}s ({total_time/60:.1f} min)")
    log.info("=" * 70)

    # --- 11. Sauvegarder historique du run ---
    if cfg.save_results:
        _save_run_history(spark, cfg, {
            "nb_input": nb_total,
            "nb_cp_sat": n_cpsat,
            "nb_residuel": n_resid,
            "nb_non_traite": n_nt,
            "nb_exact": n_exact,
            "nb_a_revoir": n_a_revoir,
            "nb_paquets": n_paquets,
            "nb_paquets_non_prouves": n_non_prouves,
            "nb_budget_depasse": n_budget,
            "taux_pct": taux,
            "duree_total_s": total_time,
            "duree_chargement_s": timings.get("chargement", 0),
            "duree_solve_s": timings.get("solve", 0),
            "duree_postprocess_s": timings.get("postprocess", 0),
            "n_groupes": n_groups,
            "n_partitions": n_partitions,
            "groupes_par_sec": n_groups / max(timings.get("solve", 1), 0.1),
        })

    df_solved.unpersist()
    return df_detail, df_stats, df_coherence
